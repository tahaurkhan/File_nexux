<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FileNexus.Shared\FileNexus.Shared.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\filenexus_engine\target\release\libfilenexus_engine.so" Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\filenexus_engine\target\release\libfilenexus_engine.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libfilenexus_engine.so</Link>
    </None>
  </ItemGroup>

</Project>
