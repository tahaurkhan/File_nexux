<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileNexus.UI.ViewModels"
             xmlns:models="using:FileNexus.Shared.Models"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="800"
             x:Class="FileNexus.UI.Views.Controls.SidebarControl"
             x:DataType="vm:MainWindowViewModel">

    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="8,10">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Border.Transitions>
        <Border.Width>
            <Binding Path="SidebarWidth"/>
        </Border.Width>

        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Sidebar Header & Collapse Control -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="4">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding !IsSidebarCollapsed}">
                        <TextBlock Text="VIRTUAL LIBRARY" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Collapse / Expand Button -->
                    <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}" Classes="icon-btn" ToolTip.Tip="Collapse Sidebar (Ctrl+B)">
                        <TextBlock Text="{Binding SidebarToggleIcon}" FontSize="14" Foreground="#94A3B8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Sidebar Main Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    
                    <!-- DASHBOARD -->
                    <StackPanel Spacing="4">
                        <Button Command="{Binding SelectNavigationItemCommand}" CommandParameter="{Binding DashboardNavItem}"
                                Classes="nav-item" Classes.active="{Binding DashboardNavItem.IsSelected}"
                                ToolTip.Tip="Dashboard">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <TextBlock Grid.Column="0" Text="🏠" FontSize="16" VerticalAlignment="Center" Width="24" TextAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                           Margin="8,0,0,0" IsVisible="{Binding !IsSidebarCollapsed}"/>
                                <Border Grid.Column="2" Background="#312E81" CornerRadius="10" Padding="6,2"
                                        IsVisible="{Binding !IsSidebarCollapsed}">
                                    <TextBlock Text="{Binding DashboardNavItem.BadgeCount}" Foreground="#818CF8" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- LIBRARY -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="LIBRARY" Foreground="#475569" FontSize="10" FontWeight="Bold" Margin="8,0,0,4"
                                   IsVisible="{Binding !IsSidebarCollapsed}"/>

                        <ItemsControl ItemsSource="{Binding LibraryNavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                    <Button Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SelectNavigationItemCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="nav-item" Classes.active="{Binding IsSelected}"
                                            ToolTip.Tip="{Binding Tooltip}">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Width="24" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="13"
                                                       Margin="8,0,0,0" IsVisible="{Binding !$parent[UserControl].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}"/>
                                            <Border Grid.Column="2" Background="{Binding BadgeColor}" CornerRadius="10" Padding="6,2" Opacity="0.85"
                                                    IsVisible="{Binding !$parent[UserControl].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}">
                                                <TextBlock Text="{Binding BadgeCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- SMART COLLECTIONS -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="SMART COLLECTIONS" Foreground="#475569" FontSize="10" FontWeight="Bold" Margin="8,0,0,4"
                                   IsVisible="{Binding !IsSidebarCollapsed}"/>

                        <ItemsControl ItemsSource="{Binding SmartNavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                    <Button Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SelectNavigationItemCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="nav-item" Classes.active="{Binding IsSelected}"
                                            ToolTip.Tip="{Binding Tooltip}">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Width="24" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="13"
                                                       Margin="8,0,0,0" IsVisible="{Binding !$parent[UserControl].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}"/>
                                            <Border Grid.Column="2" Background="{Binding BadgeColor}" CornerRadius="10" Padding="6,2" Opacity="0.85"
                                                    IsVisible="{Binding !$parent[UserControl].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}">
                                                <TextBlock Text="{Binding BadgeCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- WORKSPACES -->
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding !IsSidebarCollapsed}">
                            <TextBlock Grid.Column="0" Text="WORKSPACES" Foreground="#475569" FontSize="10" FontWeight="Bold" Margin="8,0,0,4"/>
                            <Button Grid.Column="1" Command="{Binding NewWorkspaceCommand}" Background="Transparent" Padding="4" ToolTip.Tip="New Workspace">
                                <TextBlock Text="➕" Foreground="#38BDF8" FontSize="11"/>
                            </Button>
                        </Grid>

                        <ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" 
                                  HorizontalAlignment="Stretch" Background="#1E293B" Foreground="White" CornerRadius="8"
                                  IsVisible="{Binding !IsSidebarCollapsed}" Margin="0,2,0,4">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Workspace">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="📁"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Collapsed workspace icon shortcut -->
                        <Button Command="{Binding NewWorkspaceCommand}" Classes="nav-item" ToolTip.Tip="Workspaces &amp; New Workspace"
                                IsVisible="{Binding IsSidebarCollapsed}">
                            <TextBlock Text="💼" FontSize="16" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- TOOLS -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOOLS" Foreground="#475569" FontSize="10" FontWeight="Bold" Margin="8,0,0,4"
                                   IsVisible="{Binding !IsSidebarCollapsed}"/>

                        <ItemsControl ItemsSource="{Binding ToolsNavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                    <Button Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SelectNavigationItemCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="nav-item" Classes.active="{Binding IsSelected}"
                                            ToolTip.Tip="{Binding Tooltip}">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Width="24" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="13"
                                                       Margin="8,0,0,0" IsVisible="{Binding !$parent[UserControl].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER (Settings, About) -->
            <Border Grid.Row="2" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                <StackPanel Spacing="4">
                    <Button Command="{Binding OpenSettingsCommand}" Classes="nav-item" ToolTip.Tip="Settings">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Text="⚙️" FontSize="15" VerticalAlignment="Center" Width="24" TextAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" FontSize="13"
                                       Margin="8,0,0,0" IsVisible="{Binding !IsSidebarCollapsed}"/>
                        </Grid>
                    </Button>

                    <Button Command="{Binding OpenAboutCommand}" Classes="nav-item" ToolTip.Tip="About FileNexus">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Text="ℹ️" FontSize="15" VerticalAlignment="Center" Width="24" TextAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="About" VerticalAlignment="Center" FontSize="13"
                                       Margin="8,0,0,0" IsVisible="{Binding !IsSidebarCollapsed}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
