<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileNexus.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="130"
             x:Class="FileNexus.UI.Views.Controls.StatisticCardControl"
             x:DataType="vm:StatisticCardViewModel">

    <Design.DataContext>
        <vm:StatisticCardViewModel Title="Indexed Files" Value="14,820" Subtitle="Total indexed files" Icon="📚" BadgeColor="#6366F1" TrendText="⚡ Verified"/>
    </Design.DataContext>

    <Border Classes="stat-card">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Header Row: Icon Badge & Trend Badge -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                <Border Grid.Column="0" Background="{Binding BadgeColor}" CornerRadius="10" Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TrendText}" Foreground="{Binding BadgeColor}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- Value Display -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,6" Spacing="2">
                <TextBlock Text="{Binding Value}" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Footer Subtitle -->
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Subtitle}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
