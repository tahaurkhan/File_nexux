<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileNexus.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="45"
             x:Class="FileNexus.UI.Views.Controls.QuickActionBarControl"
             x:DataType="vm:MainWindowViewModel">

    <Border Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" AllowAutoHide="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Label indicator -->
                <TextBlock Text="QUICK ACTIONS" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" 
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- Scan Folder Button -->
                <Button Command="{Binding ToggleFolderManagerCommand}" Classes="quick-action">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource FlaticonFolder}" Foreground="#F59E0B" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Scan Folder"/>
                    </StackPanel>
                </Button>

                <!-- Refresh Index Button -->
                <Button Command="{Binding ScanWorkspaceCommand}" IsEnabled="{Binding !IsScanning}" Classes="quick-action">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource FlaticonRefresh}" Foreground="#10B981" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh Index"/>
                    </StackPanel>
                </Button>

                <!-- New Workspace Button -->
                <Button Command="{Binding NewWorkspaceCommand}" Classes="quick-action">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource FlaticonFolder}" Foreground="#38BDF8" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="New Workspace"/>
                    </StackPanel>
                </Button>

                <!-- Recent Files Button -->
                <Button Command="{Binding OpenRecentCommand}" Classes="quick-action">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource FlaticonDocument}" Foreground="#8B5CF6" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Recent Files"/>
                    </StackPanel>
                </Button>

                <!-- Settings Button -->
                <Button Command="{Binding OpenSettingsCommand}" Classes="quick-action">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource FlaticonSettings}" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
