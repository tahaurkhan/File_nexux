<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileNexus.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="FileNexus.UI.Views.Controls.EmptyStateControl"
             x:DataType="vm:DashboardViewModel">

    <Border Classes="glass-card" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
        <StackPanel Spacing="20" HorizontalAlignment="Center">
            <!-- Modern Icon / Illustration Badge -->
            <Border CornerRadius="28" Width="96" Height="96" HorizontalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#312E81" Offset="0"/>
                        <GradientStop Color="#4338CA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="✨" FontSize="46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Text Content -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="Your library is empty." Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="FileNexus is ready to index your files without moving them. Add your first directory or workspace folder to unlock instant search, smart analytics, and duplicate detection." 
                           Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="500"/>
            </StackPanel>

            <!-- Onboarding Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Command="{Binding ScanFolderCommand}" Classes="action-primary" Padding="18,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📂" FontSize="14"/>
                        <TextBlock Text="Add Folder" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding RefreshIndexCommand}" Classes="dash-btn-secondary" Padding="18,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚡" FontSize="14"/>
                        <TextBlock Text="Start First Scan" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Feature Pills -->
            <Grid ColumnDefinitions="*, *, *" Margin="0,16,0,0">
                <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="🔒 Privacy-First" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Files remain in place" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="🚀 Fast Indexing" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Powered by Rust" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="📊 Rich Analytics" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Duplicates &amp; Storage" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
