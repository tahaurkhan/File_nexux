<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileNexus.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="70"
             x:Class="FileNexus.UI.Views.Controls.HeaderControl"
             x:DataType="vm:MainWindowViewModel">

    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnDefinitions="Auto, *, Auto">
            <!-- App Branding & Breadcrumb Navigation -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <!-- Sidebar Toggle Button (ChatGPT style) -->
                <Button Command="{Binding ToggleSidebarCommand}" Classes="icon-btn" ToolTip.Tip="Toggle Sidebar (Ctrl+B)">
                    <TextBlock Text="{Binding SidebarToggleIcon}" FontSize="15" Foreground="#CBD5E1"/>
                </Button>

                <!-- App Logo -->
                <Border CornerRadius="10" Background="LinearGradient(45deg, #6366F1, #3B82F6)" Width="36" Height="36">
                    <TextBlock Text="⚡" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Current Section & Breadcrumbs -->
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="FileNexus" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="/" Foreground="#475569" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ActiveSectionGroup}" Foreground="#94A3B8" FontSize="13" FontWeight="Medium"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding BreadcrumbPath}" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Global Search Bar (Raycast / ChatGPT Desktop Style) -->
            <Border Grid.Column="1" HorizontalAlignment="Center" Width="480" Height="42" 
                    Background="#1E293B" CornerRadius="21" BorderBrush="#334155" BorderThickness="1" Padding="14,0">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <!-- Search Icon -->
                    <TextBlock Grid.Column="0" Text="🔍" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- Search Input Box -->
                    <TextBox x:Name="SearchInput" Grid.Column="1" Text="{Binding SearchText, Mode=TwoWay}" 
                             PlaceholderText="Search files... (try: ext:pdf, type:image, size>100MB, favorite:true)" 
                             Background="Transparent" BorderThickness="0" Foreground="White" 
                             VerticalAlignment="Center" FontSize="13"/>

                    <!-- Clear Search Button -->
                    <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" 
                            IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="Transparent" Padding="4" Margin="4,0" ToolTip.Tip="Clear search">
                        <TextBlock Text="✕" Foreground="#94A3B8" FontSize="12"/>
                    </Button>

                    <!-- Keyboard Shortcut Badge (Ctrl+K) -->
                    <Border Grid.Column="3" Background="#0F172A" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl K" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Action Controls (Theme, Notifications, Workspace Status & User Profile) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Indexed Count Pill -->
                <Border Background="#1E1B4B" BorderBrush="#312E81" BorderThickness="1" CornerRadius="14" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="💎" FontSize="11"/>
                        <TextBlock Text="{Binding TotalFileCount, StringFormat='{}{0:N0} Files'}" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Theme Toggle Button -->
                <Button Command="{Binding ToggleThemeCommand}" Classes="icon-btn" ToolTip.Tip="Toggle Theme (Dark/Light)">
                    <TextBlock Text="{Binding ThemeIcon}" FontSize="15"/>
                </Button>

                <!-- Notification Bell Button -->
                <Button Classes="icon-btn" ToolTip.Tip="Notifications">
                    <Grid>
                        <TextBlock Text="🔔" FontSize="15"/>
                        <Ellipse Width="6" Height="6" Fill="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"/>
                    </Grid>
                </Button>

                <!-- Profile / Settings Avatar Button -->
                <Button Command="{Binding OpenSettingsCommand}" Classes="icon-btn" ToolTip.Tip="Profile &amp; Settings">
                    <Border CornerRadius="12" Background="#334155" Width="26" Height="26">
                        <TextBlock Text="👤" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
