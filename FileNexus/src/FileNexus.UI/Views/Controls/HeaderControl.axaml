<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileNexus.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="70"
             x:Class="FileNexus.UI.Views.Controls.HeaderControl"
             x:DataType="vm:MainWindowViewModel">

    <Border Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnDefinitions="Auto, *, Auto">
            <!-- App Branding & Breadcrumb Navigation -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <!-- Sidebar Toggle Button -->
                <Button Command="{Binding ToggleSidebarCommand}" Classes="icon-btn" ToolTip.Tip="Toggle Sidebar (Ctrl+B)">
                    <TextBlock Text="{Binding SidebarToggleIcon}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>

                <!-- App Logo -->
                <Border CornerRadius="10" Width="36" Height="36" ClipToBounds="True"
                        ToolTip.Tip="FileNexus v0.1.0">
                    <Image Source="avares://FileNexus.UI/Assets/app_logo.png" Stretch="Uniform"/>
                </Border>

                <!-- Current Section & Breadcrumbs -->
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="FileNexus" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="/" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ActiveSectionGroup}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding BreadcrumbPath}" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Global Search Bar -->
            <Border Grid.Column="1" HorizontalAlignment="Center" Width="480" Height="42" 
                    Background="{DynamicResource SearchBackgroundBrush}" CornerRadius="21" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,0">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <!-- Search Icon -->
                    <PathIcon Grid.Column="0" Data="{StaticResource FlaticonSearch}" Foreground="{DynamicResource TextMutedBrush}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- Search Input Box -->
                    <TextBox x:Name="SearchInput" Grid.Column="1" Text="{Binding SearchText, Mode=TwoWay}" 
                             PlaceholderText="Search files... (e.g. report.pdf, ext:png, favorite:true)" 
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" 
                             VerticalAlignment="Center" FontSize="13"/>

                    <!-- Clear Search Button -->
                    <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" 
                            IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="Transparent" Padding="4" Margin="4,0" ToolTip.Tip="Clear search">
                        <TextBlock Text="✕" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    </Button>

                    <!-- Keyboard Shortcut Badge (Ctrl+K) -->
                    <Border Grid.Column="3" Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl K" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Action Controls (Theme Toggle, Settings) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Indexed Count Pill -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource FlaticonDatabase}" Foreground="#A5B4FC" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalFileCount, StringFormat='{}{0:N0} Files'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Theme Toggle Button (Cycles System, Light, Dark) -->
                <Button Command="{Binding ToggleThemeCommand}" Classes="icon-btn" ToolTip.Tip="Appearance Theme (System / Light / Dark)">
                    <TextBlock Text="{Binding ThemeIcon}" FontSize="15"/>
                </Button>

                <!-- Settings Button -->
                <Button Command="{Binding OpenSettingsCommand}" Classes="icon-btn" ToolTip.Tip="Settings">
                    <Border CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Width="26" Height="26">
                        <PathIcon Data="{StaticResource FlaticonSettings}" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
