<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileNexus.UI.ViewModels"
             xmlns:models="using:FileNexus.Shared.Models"
             xmlns:controls="using:FileNexus.UI.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="FileNexus.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Design.DataContext>
        <vm:DashboardViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *">
        <!-- 1. TOP HEADER & QUICK ACTIONS BAR -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid ColumnDefinitions="*, Auto">
                <!-- Greeting & Workspace Info -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding GreetingText}" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold"/>
                        <Border Background="#1E293B" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🏢 Workspace:" Foreground="#64748B" FontSize="11"/>
                                <ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}" 
                                          Background="Transparent" BorderThickness="0" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Workspace">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding GreetingSubtext}" Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding ScanFolderCommand}" Classes="action-primary">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📂"/>
                            <TextBlock Text="Scan Folder"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshIndexCommand}" Classes="dash-btn-secondary">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄"/>
                            <TextBlock Text="Refresh Index"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NewWorkspaceCommand}" Classes="dash-btn-secondary">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="➕"/>
                            <TextBlock Text="New Workspace"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenDuplicatesCommand}" Classes="dash-btn-secondary">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔍"/>
                            <TextBlock Text="Find Duplicates"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImportIndexCommand}" Classes="dash-btn-secondary">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📥"/>
                            <TextBlock Text="Import Index"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SettingsCommand}" Classes="icon-btn" ToolTip.Tip="Settings">
                        <TextBlock Text="⚙️"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN DASHBOARD CONTENT AREA -->
        <Grid Grid.Row="1">
            <!-- EMPTY STATE (If library has 0 files) -->
            <controls:EmptyStateControl IsVisible="{Binding !HasFiles}"/>

            <!-- FULL DASHBOARD CONTENT (When library has files) -->
            <ScrollViewer IsVisible="{Binding HasFiles}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                <StackPanel Spacing="24">
                    
                    <!-- SECTION 1: STATISTICS CARDS -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="KEY METRICS" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding StatCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatisticCardViewModel">
                                    <controls:StatisticCardControl Margin="0,0,12,12" Width="220"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- SECTION 2: CATEGORY OVERVIEW -->
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="CATEGORY OVERVIEW" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="Click category to explore files" Foreground="#475569" FontSize="11"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CategoryCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryCardViewModel">
                                    <controls:CategoryCardControl Margin="0,0,12,12" Width="260"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- SECTION 3: STORAGE ANALYTICS -->
                    <controls:StorageAnalyticsControl DataContext="{Binding}"/>

                    <!-- SECTION 4: DUPLICATE SUMMARY -->
                    <controls:DuplicateSummaryControl DataContext="{Binding}"/>

                    <!-- SECTION 5: RECENT ACTIVITIES & LARGEST FILES -->
                    <Grid ColumnDefinitions="*, *">
                        <controls:RecentFilesControl Grid.Column="0" DataContext="{Binding}" Margin="0,0,10,0"/>
                        <controls:LargestFilesControl Grid.Column="1" DataContext="{Binding}" Margin="10,0,0,0"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
