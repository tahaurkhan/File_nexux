<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:FileNexus.UI.Views.Controls"
        x:Class="FileNexus.UI.Views.SplashWindow"
        Title="FileNexus"
        Width="500" Height="340"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="True"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Border CornerRadius="20" ClipToBounds="True" BorderBrush="#334155" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#0F172A" Offset="0"/>
                <GradientStop Color="#1E1B4B" Offset="0.6"/>
                <GradientStop Color="#0F172A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid RowDefinitions="*, Auto">
            <!-- Central Logo & Branding -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <!-- App Logo Image with Outer Glow -->
                <Border Width="110" Height="110" CornerRadius="24" ClipToBounds="True" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Color="#6366F1" Opacity="0.75" OffsetX="0" OffsetY="0"/>
                    </Border.Effect>
                    <controls:AppLogoControl Width="110" Height="110" LogoCornerRadius="24"/>
                </Border>

                <!-- App Name & Subtitle -->
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="FileNexus" 
                               Foreground="White" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"
                               LetterSpacing="1"/>
                    <TextBlock Text="Modern Virtual File Library" 
                               Foreground="#94A3B8" 
                               FontSize="13" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Progress Bar & Loading Indicator -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,32" Spacing="12">
                <!-- Glowing Progress Bar -->
                <Border Width="240" Height="5" Background="#1E293B" CornerRadius="3" HorizontalAlignment="Center" ClipToBounds="True">
                    <ProgressBar x:Name="SplashProgressBar" Minimum="0" Maximum="1" Value="0.1" Height="5" 
                                 Background="Transparent" Foreground="#6366F1" CornerRadius="3"/>
                </Border>

                <!-- Status Message -->
                <TextBlock x:Name="StatusText"
                           Text="Starting FileNexus…" 
                           Foreground="#94A3B8" 
                           FontSize="12" 
                           FontWeight="Medium"
                           HorizontalAlignment="Center"/>

                <!-- Version Badge -->
                <TextBlock Text="v0.1.0" 
                           Foreground="#475569" 
                           FontSize="10" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
