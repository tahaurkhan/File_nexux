<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileNexus.UI.ViewModels"
        xmlns:models="using:FileNexus.Shared.Models"
        xmlns:controls="using:FileNexus.UI.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="FileNexus.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FileNexus — Modern Virtual File Library"
        Width="1380" Height="860"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}"/>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding ScanWorkspaceCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewWorkspaceCommand}"/>
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
        <!-- 1. TOP NATIVE DESKTOP MENU BAR -->
        <controls:MenuBarControl Grid.Row="0"/>

        <!-- 2. HEADER BAR (Logo, Breadcrumb, Global Search, Theme, Notifications, Profile) -->
        <controls:HeaderControl Grid.Row="1"/>

        <!-- 3. QUICK ACTION TOOLBAR -->
        <controls:QuickActionBarControl Grid.Row="2"/>

        <!-- 4. MAIN APPLICATION BODY (Sidebar + Secondary Extensions + Files List) -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto, *">
            <!-- A. COLLAPSIBLE CHATGPT-STYLE SIDEBAR -->
            <controls:SidebarControl Grid.Column="0"/>

            <!-- B. CENTER CONTENT AREA -->
            <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *">
                <!-- Folder Manager Drawer Modal -->
                <Border Grid.Row="0" IsVisible="{Binding IsFolderManagerOpen}" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="16">
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <TextBox Grid.Column="0" Text="{Binding NewFolderPath, Mode=TwoWay}" PlaceholderText="Enter folder path to index (e.g., /home/user/Downloads or C:\Documents)..." 
                                 Background="#0F172A" Foreground="White" BorderBrush="#334155" CornerRadius="6" Padding="10,8" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Command="{Binding AddWorkspaceFolderCommand}" Background="#10B981" Foreground="White" CornerRadius="6" Padding="14,8" Margin="0,0,8,0">
                            <TextBlock Text="Start Indexing"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ToggleFolderManagerCommand}" Background="#334155" Foreground="White" CornerRadius="6" Padding="10,8">
                            <TextBlock Text="Cancel"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- SECONDARY EXTENSION FILTER PANEL -->
                <controls:ExtensionPanelControl Grid.Row="1"/>

                <!-- MAIN FILE VIRTUAL COLLECTION LIST & DETAILS DRAWER -->
                <Grid Grid.Row="2" ColumnDefinitions="*, 320">
                    <!-- File Records List -->
                    <ListBox Grid.Column="0" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent" Padding="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FileItem">
                                <Border Background="#1E293B" CornerRadius="8" Padding="14,11" Margin="0,3" BorderBrush="#334155" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                        <!-- Extension Badge -->
                                        <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" Padding="10,5" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Extension, StringFormat='.{0}'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                                        </Border>

                                        <!-- File Metadata -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding AbsolutePath}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Size & Modified Date -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0" Spacing="2">
                                            <TextBlock Text="{Binding FormattedSize}" Foreground="#E2E8F0" FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding ModifiedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- Favorite Toggle Button -->
                                        <Button Grid.Column="3" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleFavoriteCommand}" CommandParameter="{Binding}"
                                                Background="Transparent" Padding="6" VerticalAlignment="Center">
                                            <TextBlock Text="⭐" Opacity="{Binding IsFavorite}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- File Details Drawer -->
                    <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1,0,0,0" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16" IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="FILE DETAILS" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>

                                <!-- Large Icon & File Name -->
                                <Border Background="#1E293B" CornerRadius="10" Padding="18" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <TextBlock Text="📄" FontSize="44" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedFile.Name}" Foreground="White" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        <Border Background="#38BDF8" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedFile.Extension, StringFormat='.{0}'}" Foreground="#0F172A" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Open File & Open Folder Actions -->
                                <Grid ColumnDefinitions="*, *">
                                    <Button Grid.Column="0" Command="{Binding OpenFileCommand}" CommandParameter="{Binding SelectedFile}" 
                                            Classes="action-primary" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <TextBlock Text="Open File"/>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedFile}" 
                                            Classes="quick-action" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <TextBlock Text="Open Folder"/>
                                    </Button>
                                </Grid>

                                <!-- Detailed Metadata Specs -->
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Full Absolute Path" Foreground="#64748B" FontSize="11"/>
                                        <SelectableTextBlock Text="{Binding SelectedFile.AbsolutePath}" Foreground="#E2E8F0" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="File Size" Foreground="#64748B" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedFile.FormattedSize}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Category" Foreground="#64748B" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedFile.Category}" Foreground="#E2E8F0" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Last Modified" Foreground="#64748B" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedFile.ModifiedAt, StringFormat='{}{0:f}'}" Foreground="#E2E8F0" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Tags Metadata Editor -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="TAGS" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedFile.Tags, Mode=TwoWay}" PlaceholderText="Add tags (comma separated)..." 
                                             Background="#1E293B" Foreground="White" BorderBrush="#334155" CornerRadius="6" Padding="8"/>
                                    <Button Command="{Binding SaveTagsCommand}" CommandParameter="{Binding SelectedFile.Tags}" 
                                            Classes="quick-action" HorizontalAlignment="Right">
                                        <TextBlock Text="Save Tags" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 5. FOOTER STATUS BAR -->
        <Border Grid.Row="4" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="●" Foreground="#10B981" VerticalAlignment="Center" FontSize="10"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="FileNexus — Virtual File Library" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
