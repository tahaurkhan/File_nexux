<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileNexus.UI.App"
             xmlns:local="using:FileNexus.UI"
             RequestedThemeVariant="Dark">
             <!-- Set Dark theme variant by default for rich modern desktop aesthetics -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://FileNexus.UI/Styles/NavigationStyles.axaml"/>
    </Application.Styles>
</Application>