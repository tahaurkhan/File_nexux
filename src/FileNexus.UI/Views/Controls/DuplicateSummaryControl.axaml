<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileNexus.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="180"
             x:Class="FileNexus.UI.Views.Controls.DuplicateSummaryControl"
             x:DataType="vm:DashboardViewModel">

    <Border Classes="dashboard-card" BorderBrush="#4338CA">
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#1E1B4B" Offset="0"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid ColumnDefinitions="*, Auto">
            <!-- Left Information -->
            <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Background="#4338CA" CornerRadius="10" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🗑️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Duplicate Storage Cleanup" Classes="section-title" Foreground="#F8FAFC"/>
                        <TextBlock Text="Reclaim disk space by reviewing identical file hashes across your index" Classes="section-subtitle"/>
                    </StackPanel>
                </StackPanel>

                <!-- Statistics Pills -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Groups:" Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Text="{Binding DuplicateSummary.GroupCount}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Duplicates:" Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Text="{Binding DuplicateSummary.TotalDuplicateCount}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Reclaimable:" Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Text="{Binding DuplicateSummary.PotentialSavingsFormatted}" Foreground="#10B981" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Right Call To Action Button -->
            <Button Grid.Column="1" Command="{Binding OpenDuplicatesCommand}" Classes="action-primary" VerticalAlignment="Center" Padding="18,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🔍" FontSize="14"/>
                    <TextBlock Text="Review Duplicates" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
