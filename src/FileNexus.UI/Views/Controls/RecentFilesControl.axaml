<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileNexus.UI.ViewModels"
             xmlns:models="using:FileNexus.Shared.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="350"
             x:Class="FileNexus.UI.Views.Controls.RecentFilesControl"
             x:DataType="vm:DashboardViewModel">

    <Border Classes="dashboard-card">
        <Grid RowDefinitions="Auto, *">
            <!-- Header Row -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,14">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Recent Activity" Classes="section-title"/>
                    <TextBlock Text="Files created or modified recently across your workspace" Classes="section-subtitle"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshIndexCommand}" Classes="dash-btn-secondary">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🔄"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Cards List for Recent Files (Not a plain list!) -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentFiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:FileItem">
                        <Border Background="#0F172A" CornerRadius="10" Padding="12,10" BorderBrush="#334155" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                <!-- Thumbnail / Category Icon Badge -->
                                <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- File Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <Border Background="#38BDF8" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Extension, StringFormat='.{0}'}" Foreground="#0F172A" FontWeight="Bold" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AbsolutePath}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Modified Time & Size -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0" Spacing="2">
                                    <TextBlock Text="{Binding FormattedSize}" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding ModifiedAt, StringFormat='{}{0:g}'}" Foreground="#64748B" FontSize="10" HorizontalAlignment="Right"/>
                                </StackPanel>

                                <!-- Quick Actions (Open, Reveal, Favorite) -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).ToggleFavoriteCommand}" 
                                            CommandParameter="{Binding}" Classes="icon-btn" ToolTip.Tip="Toggle Favorite">
                                        <TextBlock Text="⭐" Opacity="{Binding IsFavorite}"/>
                                    </Button>

                                    <Button Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).OpenFileCommand}" 
                                            CommandParameter="{Binding}" Classes="icon-btn" ToolTip.Tip="Open File">
                                        <TextBlock Text="↗️"/>
                                    </Button>

                                    <Button Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).RevealFileCommand}" 
                                            CommandParameter="{Binding}" Classes="icon-btn" ToolTip.Tip="Reveal in Folder">
                                        <TextBlock Text="📁"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
