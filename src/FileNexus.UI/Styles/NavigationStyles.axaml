<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Background="#0F172A">
            <!-- Preview controls -->
            <StackPanel Spacing="10">
                <Button Classes="nav-item active" Content="Documents"/>
                <Button Classes="nav-item" Content="Images"/>
                <Button Classes="quick-action" Content="Scan Folder"/>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- Navigation Item Button Style -->
    <Style Selector="Button.nav-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.nav-item:pointerover">
        <Setter Property="Background" Value="#1E293B"/>
        <Setter Property="Foreground" Value="#F8FAFC"/>
    </Style>

    <Style Selector="Button.nav-item.active">
        <Setter Property="Background" Value="#6366F1"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button.nav-item.active:pointerover">
        <Setter Property="Background" Value="#4F46E5"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Quick Action Button Style -->
    <Style Selector="Button.quick-action">
        <Setter Property="Background" Value="#1E293B"/>
        <Setter Property="Foreground" Value="#E2E8F0"/>
        <Setter Property="BorderBrush" Value="#334155"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.quick-action:pointerover">
        <Setter Property="Background" Value="#334155"/>
        <Setter Property="BorderBrush" Value="#475569"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>

    <Style Selector="Button.quick-action:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <!-- Primary Action Button Style -->
    <Style Selector="Button.action-primary">
        <Setter Property="Background" Value="#6366F1"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.action-primary:pointerover">
        <Setter Property="Background" Value="#4F46E5"/>
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>

    <!-- Icon Button Style (Theme toggle, notifications, profile, collapse) -->
    <Style Selector="Button.icon-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.icon-btn:pointerover">
        <Setter Property="Background" Value="#334155"/>
        <Setter Property="Foreground" Value="#F8FAFC"/>
    </Style>

    <!-- Extension Filter Chip Button -->
    <Style Selector="Button.ext-chip">
        <Setter Property="Background" Value="#1E293B"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="BorderBrush" Value="#334155"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.ext-chip:pointerover">
        <Setter Property="Background" Value="#334155"/>
        <Setter Property="Foreground" Value="#F8FAFC"/>
        <Setter Property="BorderBrush" Value="#475569"/>
    </Style>

    <Style Selector="Button.ext-chip.active">
        <Setter Property="Background" Value="#38BDF8"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="BorderBrush" Value="#38BDF8"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Native Desktop Menu Styling -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="#0F172A"/>
        <Setter Property="Foreground" Value="#CBD5E1"/>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="#CBD5E1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="#334155"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
</Styles>
